# Dependencies and build output
node_modules/
dist/
coverage/
# Playwright output
test-results/
playwright-report/
blob-report/
*.tsbuildinfo

# Compiled COBOL artefacts
*.so
*.dylib
*.o
cobol/bin/

# Equivalence results are regenerated on every test run (new random seed).
# Recorded results for the hosted demo will live elsewhere.
results/

# Blender intermediates (raw GLB, bake PNGs, full-size renders); regenerate with npm run art:lab
art/lab/build/
*.blend1

# Local environment and secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store

# NOTE: never ignore .kiro/ - the hackathon rules require it in the repo.

# Lab scene perf measurements (machine-specific); regenerate with npm run perf:scene -w web
web/perf/results/
# Video production files (capture script, shot list, narration, licences): kept local, never committed
web/video/
docs/demo/
# Kiro task-run state (PBT results, timestamps); the spec .md files stay committed
.kiro/specs/*/tasks.meta.json
